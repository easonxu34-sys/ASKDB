# Copy to .env.docker. Configure the model and data source in the web UI.
# Required Fernet key for persistent encrypted model and Wren settings.
ASKDB_SETTINGS_ENCRYPTION_KEY=
# The startup script injects the public Tailscale Funnel HTTPS origin.
# This local fallback is only for direct Compose commands.
ASKDB_WEB_ORIGIN=http://localhost:3001
# Only needed if you enable the optional Cloudflare named tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
# WREN_PROJECT_DIR is deliberately unset: create data sources in Web onboarding.
