# Copy to .env.docker and supply local deployment secrets. Secrets stay outside Git.
# Required Fernet key for persistent encrypted model and Wren settings.
ASKDB_SETTINGS_ENCRYPTION_KEY=
# Required token for a Cloudflare named tunnel (not a Quick Tunnel).
CLOUDFLARE_TUNNEL_TOKEN=
# Hostname only, without scheme or path, e.g. askdb.example.com.
# In Cloudflare, set the published route's service to http://web:3000.
CLOUDFLARE_TUNNEL_HOSTNAME=
# WREN_PROJECT_DIR is deliberately unset: create data sources in Web onboarding.
