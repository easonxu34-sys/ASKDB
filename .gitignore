# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
**/out/

# production
**/build/

# misc
.DS_Store
*.pem
**/.idea/
/.pnpm-store/
/.superpowers/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
**/.env*
!**/.env.example
/.env.docker
!/.env.docker.example
/.env.local
!/.env.local.example
/.local-deploy/

# vercel
**/.vercel/

# typescript
**/*.tsbuildinfo
**/next-env.d.ts

# Python
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
/askdb-agent/data/
# Local Wren semantic project: datasource-specific, never shipped with the repo.
/askdb-project/
