# Optional legacy Wren project to import once during migration. Leave empty for new installs.
WREN_PROJECT_DIR=
# Optional legacy profile used together with WREN_PROJECT_DIR for that import.
WREN_PROFILE=

# Configure the model provider required by the selected LangChain chat model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
ASKDB_MODEL=openai:deepseek-v4-flash

# One application PostgreSQL database for accounts, settings, conversations, and memory.
# Local default: service alias configured in ~/.pg_service.conf.
# Other deployments can use a PostgreSQL URL, for example:
# ASKDB_DATABASE_DSN=postgresql://askdb_agent_dev@127.0.0.1:5432/askdb_agent_dev
ASKDB_DATABASE_DSN=service=askdb-agent-dev
# Keep the Fernet key in a deployment secret manager.
ASKDB_SETTINGS_ENCRYPTION_KEY=

# Local files that remain outside PostgreSQL: the deletion journal and corpus artifacts.
# ASKDB_AGENT_DATA_DIR=./data

# Persistent memory and online recall start by default. The Agent creates its
# journal and a stable Fernet key under ./data/agent-memory/ on first startup.
# Keep that directory in persistent storage and include the key in backups.
# ASKDB_AGENT_RECALL_ENABLED=0
# Optional overrides for deployments that manage these paths/keys externally:
# ASKDB_MEMORY_JOURNAL_PATH=
# ASKDB_MEMORY_JOURNAL_KEY=
# ASKDB_AGENT_MEMORY_CORPUS_DIR=./data/agent-memory-corpus
