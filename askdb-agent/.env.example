# Wren CLI prepared project directory containing wren_project.yml and target/mdl.json
WREN_PROJECT_DIR=../wren-project
# Pin a project profile; do not depend on a globally active profile.
WREN_PROFILE=

# Configure the model provider required by the selected LangChain chat model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
ASKDB_MODEL=openai:deepseek-v4-flash

# Deployment-wide model settings. Keep the Fernet key in a deployment secret manager.
ASKDB_SETTINGS_DB_PATH=./data/model-settings.sqlite3
ASKDB_SETTINGS_ENCRYPTION_KEY=

# Optional persistent agent memory. Keep the journal key stable across restarts.
# The journal path must be outside both the settings database and corpus directories.
# ASKDB_AGENT_MEMORY_ENABLED=1
# ASKDB_MEMORY_JOURNAL_PATH=./data/agent-memory/deletion-journal.jsonl
# ASKDB_MEMORY_JOURNAL_KEY=
# ASKDB_AGENT_MEMORY_CORPUS_DIR=./data/agent-memory-corpus
# Online recall follows ASKDB_AGENT_MEMORY_ENABLED and defaults to enabled when
# persistent memory is configured. Set this only to explicitly disable recall.
# ASKDB_AGENT_RECALL_ENABLED=0
